<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Тесты идут на той же среде исполнения, что и приложение (.NET Framework 4.8). -->
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>Grapher.Core.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Требование xUnit.net v3: тестовая сборка исполняемая. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <!-- xUnit.net v3: тесты запускаются через Microsoft.Testing.Platform (поддерживается dotnet test .NET 10+ и Test Explorer VS). -->
    <PackageReference Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Grapher.Core\Grapher.Core.csproj" />
  </ItemGroup>

</Project>
