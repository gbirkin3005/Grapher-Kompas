* text=auto

# Командные файлы Windows понимают только CRLF; скрипты PowerShell со строками на русском
# сохраняются в UTF-8 с BOM (иначе Windows PowerShell 5.1 читает их в кодировке ANSI).
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.sln text eol=crlf

*.ico  binary
*.png  binary
*.xlsx binary
*.xls  binary
*.dll  binary
